			"LoadingPhase": "Default",
			"TargetDenyList": ["Server"]
		},
		{
			"Name": "ArcRmlUIShaders",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"TargetDenyList": ["Server"]
		},
		{
			"Name": "ArcRmlUI",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"TargetDenyList": ["Server"]
		},
		{
